# ─── Media dashboard (required) ──────────────────────────────────────────────
# The password for the dashboard reached via the "©" in the site footer.
# Until BOTH of these are set, sign-in is disabled and the dashboard refuses
# to authenticate anyone — it fails closed rather than falling back to a
# default password.
ADMIN_PASSWORD=Majd_OssaKbeere

# Signs the session cookie. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this signs everyone out.
AUTH_SECRET=

# ─── Storage (required when hosted) ──────────────────────────────────────────
# Absolute path to a PERSISTENT, WRITABLE directory for dashboard uploads.
# It must be a mounted volume, not a path inside the project, or every deploy
# wipes the uploads. Defaults to ./data for local development.
MEDIA_DATA_DIR=/data

# Keeps Server Action ids decryptable across restarts and instances. Without
# it, a redeploy can invalidate in-flight actions. Same generator as above.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ─── Contact form (optional) ─────────────────────────────────────────────────
# Without a key the contact form still validates but does not send.
RESEND_API_KEY=
